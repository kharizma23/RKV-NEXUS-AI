# Environment Configuration Example
# Copy to .env for local development

# General App Config
PROJECT_NAME="Integrated AI Assessment Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="dev_secret_key_change_in_production_min_32_chars_long"
CSRF_SECRET="dev_csrf_secret_change_in_production_min_32_chars_long"

# CORS Settings (JSON list or comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assessment_db
POSTGRES_USER=assessment_user
POSTGRES_PASSWORD=assessment_password
DATABASE_URL=postgresql+asyncpg://assessment_user:assessment_password@localhost:5432/assessment_db
SYNC_DATABASE_URL=postgresql+psycopg2://assessment_user:assessment_password@localhost:5432/assessment_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=assessment-files
MINIO_SECURE=false

# Security & JWT Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false  # Set to true in production with HTTPS
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost

# Development Initial Seed Credentials
SEED_ADMIN_EMAIL=admin@platform.edu
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_FACULTY_APPROVED_EMAIL=faculty.approved@platform.edu
SEED_FACULTY_PENDING_EMAIL=faculty.pending@platform.edu
SEED_FACULTY_PASSWORD=FacultyPassword123!
SEED_STUDENT_EMAIL=student@platform.edu
SEED_STUDENT_PASSWORD=StudentPassword123!

# AI Integration Configuration
AI_PROVIDER=openai
AI_API_KEY=
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
