# ============================================
# RKV NEXUS AI — .gitignore
# ============================================

# ──── Environment & Secrets ────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ──── Client (Next.js) ────
client/node_modules/
client/.next/
client/out/
client/build/
client/.vercel/
client/coverage/
client/playwright-report/
client/test-results/
client/tsconfig.tsbuildinfo

# ──── Server (Python/FastAPI) ────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
server/.venv/
.venv/
env/
venv/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
server/coverage/
server/htmlcov/
server/.coverage
server/uploads/*
!server/uploads/.gitkeep

# ──── Database & Storage Volumes ────
*.sqlite
*.db
minio-data/
postgres-data/

# ──── IDE & OS ────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ──── Root Node Modules ────
node_modules/

# ──── Logs ────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# ──── Build Artifacts ────
dist/
*.egg-info/
*.egg

# ──── Agent State ────
.agents/
.gemini/
.neon
